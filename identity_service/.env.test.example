# Test configuration for the Identity Service test suite.
# Copy this file to `.env.test` (gitignored) before running `pytest`, or set
# TEST_DATABASE_URL in your shell / CI environment.
#
# Point this at a THROWAWAY database — the suite drops and recreates its schema.
# The value below matches the local dev Postgres container.
TEST_DATABASE_URL=postgresql+asyncpg://identity:identity@localhost:5433/identity_test

# Optional: override the bootstrap admin email used in RBAC tests.
# (The admin password is generated per run if not set here.)
# BOOTSTRAP_ADMIN_EMAIL=admin@test.local
