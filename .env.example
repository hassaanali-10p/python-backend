# Copy this file to `.env` (gitignored), then run `docker-compose up`.
# docker-compose loads `.env` automatically. These values are REQUIRED —
# compose now fails fast if POSTGRES_USER/PASSWORD/DB are missing.

# --- Postgres (required) ---
POSTGRES_USER=identity
POSTGRES_PASSWORD=change-me
POSTGRES_DB=identity

# --- Identity Service database ---
# Under docker-compose this is built automatically from the POSTGRES_* vars
# above and injected into the container, so you can leave it unset.
# For running the Identity Service locally (outside Docker), set it explicitly:
# DATABASE_URL=postgresql+asyncpg://identity:identity@localhost:5432/identity

# --- Shared ---
LOG_LEVEL=INFO
ENVIRONMENT=development

# --- Bootstrap admin (optional) ---
# If both are set, an admin user is created on Identity Service startup.
# Useful for demonstrating role-based access control.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-pass
